{
  "name": "pino-http-transport",
  "version": "0.1.0",
  "url": "https://github.com/sandrinodimattia/pino-http-transport",
  "description": "A pino transport for sending logs to an HTTP endpoint",
  "main": "./dist/index.js",
  "module": "dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "prepare": "husky install",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pino"
  ],
  "author": "Sandrino Di Mattia",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "pino": "^10.1.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "exponential-backoff": "^3.1.3",
    "pino-abstract-transport": "^3.0.0"
  }
}